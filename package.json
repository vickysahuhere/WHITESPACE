{
  "name": "whitespace-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "White Collars (WHITESPACE) // Autonomous Workspace OS",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:pack": "npm run build && electron-builder --dir",
    "test": "node test/verify_system.mjs && node test/test_all_features.mjs",
    "test:runtime": "electron test/run_runtime_verification.cjs"
  },
  "build": {
    "appId": "com.whitecollars.whitespace",
    "productName": "WhiteCollarsOS",
    "copyright": "Copyright (C) 2026 White Collars",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "${productName}_v${version}_${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^9.5.1"
  }
}
